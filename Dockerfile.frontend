FROM python:3.11-slim

RUN apt-get update && apt-get install -y libgomp1 libstdc++6 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-frontend.txt requirements.txt
RUN pip install --no-cache-dir --default-timeout=600 --retries=10 -r requirements.txt

# Copy the app directory
COPY app ./app

ENV PYTHONPATH=/app

EXPOSE 8501

CMD ["streamlit", "run", "app/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]