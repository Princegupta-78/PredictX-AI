# Use an official lightweight Python image
FROM python:3.11-slim

# Install system dependencies required by XGBoost
RUN apt-get update && apt-get install -y libgomp1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=600 --retries=10 -r requirements.txt

# Copy backend and ml directories
COPY backend ./backend
COPY ml ./ml

# Critical: Let Python know where the root and ml directories are
ENV PYTHONPATH=/app:/app/ml

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]